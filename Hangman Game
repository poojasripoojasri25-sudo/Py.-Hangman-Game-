
import random

words = ["apple", "mango", "tiger", "hello", "python"]

word = random.choice(words)
guessed = []
attempts = 6

print("===== HANGMAN GAME =====")

while attempts > 0:
    display = ""

    for letter in word:
        if letter in guessed:
            display += letter + " "
        else:
            display += "_ "

    print("\nWord:", display)
    print("Attempts left:", attempts)

    if "_" not in display:
        print("Congratulations! You won!")
        break

    guess = input("Guess a letter: ").lower()

    if len(guess) != 1 or not guess.isalpha():
        print("Enter only one letter!")
        continue

    if guess in guessed:
        print("Already guessed!")
        continue

    guessed.append(guess)

    if guess not in word:
        print("Wrong guess!")
        attempts -= 1
    else:
        print("Correct guess!")

if attempts == 0:
    print("Game Over! The word was:", word)
